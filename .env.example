# ═══════════════════════════════════════════════════════════
# LiveStudio — Self-Hosted Live Streaming Studio
# Environment Configuration
# ═══════════════════════════════════════════════════════════

# Application
APP_NAME=LiveStudio
APP_URL=https://studio.example.com
NODE_ENV=production

# ─── PostgreSQL ───────────────────────────────────────────
POSTGRES_DB=livestudio
POSTGRES_USER=livestudio
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql://livestudio:CHANGE_ME_STRONG_PASSWORD@postgres:5432/livestudio?schema=public

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── MinIO (S3-Compatible Object Storage) ─────────────────
MINIO_ROOT_USER=livestudio
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=livestudio
MINIO_REGION=us-east-1

# ─── LiveKit (WebRTC SFU) ─────────────────────────────────
LIVEKIT_API_KEY=APIxxxxxxxxxx
LIVEKIT_API_SECRET=CHANGE_ME_LIVEKIT_SECRET
LIVEKIT_URL=wss://studio.example.com/livekit
LIVEKIT_HTTP_URL=http://livekit:7880

# ─── TURN Server ──────────────────────────────────────────
TURN_DOMAIN=studio.example.com
TURN_USERNAME=livestudio
TURN_PASSWORD=CHANGE_ME_TURN_PASSWORD
TURN_PORT=3478
TURN_TLS_PORT=5349

# ─── Authentication ───────────────────────────────────────
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── Encryption (for stream keys, credentials) ────────────
ENCRYPTION_KEY=CHANGE_ME_32_BYTE_HEX_KEY

# ─── SMTP (Email) ─────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# ─── AI Service ───────────────────────────────────────────
AI_PROVIDER=local
AI_API_KEY=

# ─── Feature Flags ────────────────────────────────────────
ENABLE_AI_CLIPS=true
ENABLE_WEBINARS=true
ENABLE_LOCAL_RECORDING=true
ENABLE_EXTRA_CAMERA=true
ENABLE_GUEST_DESTINATIONS=false

# ─── Storage Limits ──────────────────────────────────────
MAX_WORKSPACE_STORAGE_GB=50
MAX_RECORDING_SIZE_GB=5
DELETE_RECORDINGS_AFTER_DAYS=0

# ─── Backend Server ──────────────────────────────────────
API_PORT=4000
WS_PORT=4001

# ─── Frontend ─────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=LiveStudio
NEXT_PUBLIC_API_URL=https://studio.example.com/api
NEXT_PUBLIC_WS_URL=wss://studio.example.com/ws
NEXT_PUBLIC_LIVEKIT_URL=wss://studio.example.com/livekit
