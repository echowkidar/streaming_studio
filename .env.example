# ═══════════════════════════════════════════════════════════
# LiveStudio — Stack environment (Portainer -> Stack -> Environment variables)
# Generate secrets with:  openssl rand -hex 32
# ═══════════════════════════════════════════════════════════

# Public URL of the app (used for CORS)
APP_URL=https://livestudio.example.com
APP_NAME=LiveStudio

# ─── PostgreSQL (keep the SAME password your existing database volume was created with) ───
POSTGRES_DB=livestudio
POSTGRES_USER=livestudio
POSTGRES_PASSWORD=

# ─── MinIO (recordings storage) ───
MINIO_ROOT_USER=livestudio
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=livestudio

# ─── LiveKit (VPS) ───
LIVEKIT_URL=wss://livekit.example.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Build-time value for the browser bundle (normally same as LIVEKIT_URL; optional — the API also sends it)
NEXT_PUBLIC_LIVEKIT_URL=wss://livekit.example.com

# ─── Security (REQUIRED — the API refuses to start in production without strong values) ───
JWT_SECRET=
JWT_EXPIRY=7d
# 64 hex chars. Changing it makes previously saved stream keys unreadable (re-enter them in Destinations).
ENCRYPTION_KEY=

# ─── First admin (used only if no SUPER_ADMIN exists, or to replace a known default password) ───
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Set to false to stop public sign-ups (admins can still create users)
ALLOW_REGISTRATION=true

# ─── SMTP (optional) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Host port nginx listens on (cloudflared points here)
NGINX_PORT=8088
