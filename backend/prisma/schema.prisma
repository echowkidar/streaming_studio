generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  USER
}

model User {
  id           String            @id @default(cuid())
  email        String            @unique
  passwordHash String
  name         String
  avatarUrl    String?
  role         Role              @default(USER)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  sessions     Session[]
  workspaces   Workspace[]       @relation("WorkspaceOwner")
  memberships  WorkspaceMember[]
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Workspace {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  ownerId     String
  logoUrl     String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  owner       User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members     WorkspaceMember[]
  studios     Studio[]
  broadcasts  Broadcast[]
  destinations Destination[]
  recordings  Recording[]
  mediaAssets MediaAsset[]
  mediaFolders MediaFolder[]
  brandAssets BrandAsset[]
  webinars    Webinar[]

  @@index([ownerId])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  PRODUCER
  CREATOR
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(CREATOR)
  joinedAt    DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Studio {
  id            String      @id @default(cuid())
  workspaceId   String
  name          String
  description   String?
  defaultLayout String      @default("gallery")
  settings      Json        @default("{}")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  workspace     Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  broadcasts    Broadcast[]

  @@index([workspaceId])
}

enum BroadcastStatus {
  DRAFT
  SCHEDULED
  PREPARING
  GREEN_ROOM
  READY
  RECORDING
  LIVE
  ENDING
  ENDED
  FAILED
}

model Broadcast {
  id           String          @id @default(cuid())
  studioId     String
  workspaceId  String
  title        String
  status       BroadcastStatus @default(DRAFT)
  scheduledAt  DateTime?
  startedAt    DateTime?
  endedAt      DateTime?
  settings     Json            @default("{}")
  createdAt    DateTime        @default(now())
  studio       Studio          @relation(fields: [studioId], references: [id], onDelete: Restrict)
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  participants Participant[]
  recordings   Recording[]
  webinars     Webinar[]

  @@index([workspaceId])
  @@index([studioId])
}

enum ParticipantRole {
  HOST
  CO_HOST
  PRODUCER
  GUEST
}

enum ParticipantStatus {
  GREEN_ROOM
  BACKSTAGE
  ON_STAGE
  REMOVED
}

model Participant {
  id           String            @id @default(cuid())
  broadcastId  String
  userId       String?
  displayName  String
  role         ParticipantRole   @default(GUEST)
  status       ParticipantStatus @default(GREEN_ROOM)
  isAudioOnly  Boolean           @default(false)
  inviteToken  String?           @unique
  joinedAt     DateTime?
  leftAt       DateTime?
  broadcast    Broadcast         @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  recordingTracks RecordingTrack[]

  @@index([broadcastId])
  @@index([userId])
}

enum DestinationPlatform {
  YOUTUBE
  FACEBOOK
  TWITCH
  LINKEDIN
  CUSTOM_RTMP
}

enum DestinationStatus {
  DISCONNECTED
  CONNECTING
  LIVE
  RECONNECTING
  FAILED
  STOPPED
}

model Destination {
  id                 String              @id @default(cuid())
  workspaceId        String
  name               String
  platform           DestinationPlatform
  rtmpUrl            String
  streamKeyEncrypted String
  streamKeyIv        String
  streamKeyTag       String
  oauthData          Json?
  status             DestinationStatus   @default(DISCONNECTED)
  lastUsedAt         DateTime?
  createdAt          DateTime            @default(now())
  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

enum RecordingStatus {
  PROCESSING
  READY
  FAILED
}

model Recording {
  id            String           @id @default(cuid())
  broadcastId   String
  workspaceId   String
  title         String
  status        RecordingStatus  @default(PROCESSING)
  duration      Int              @default(0)
  resolution    String?
  fileSize      BigInt           @default(0)
  storagePath   String?
  thumbnailPath String?
  createdAt     DateTime         @default(now())
  broadcast     Broadcast        @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tracks        RecordingTrack[]
  aiClips       AiClip[]
  transcripts   Transcript[]

  @@index([broadcastId])
  @@index([workspaceId])
}

enum TrackType {
  VIDEO
  AUDIO
  COMBINED
}

model RecordingTrack {
  id            String       @id @default(cuid())
  recordingId   String
  participantId String?
  trackType     TrackType
  storagePath   String
  duration      Int          @default(0)
  recording     Recording    @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  participant   Participant? @relation(fields: [participantId], references: [id], onDelete: SetNull)

  @@index([recordingId])
  @@index([participantId])
}

enum AssetType {
  IMAGE
  VIDEO
  AUDIO
  PDF
  SLIDES
}

model MediaAsset {
  id            String       @id @default(cuid())
  workspaceId   String
  name          String
  assetType     AssetType
  mimeType      String
  fileSize      BigInt
  storagePath   String
  thumbnailPath String?
  metadata      Json         @default("{}")
  folderId      String?
  tags          String[]
  createdAt     DateTime     @default(now())
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folder        MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([folderId])
}

enum FolderType {
  BRAND
  MEDIA
}

model MediaFolder {
  id          String        @id @default(cuid())
  workspaceId String
  name        String
  parentId    String?
  folderType  FolderType    @default(MEDIA)
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent      MediaFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    MediaFolder[] @relation("FolderHierarchy")
  assets      MediaAsset[]
  brandAssets BrandAsset[]

  @@index([workspaceId])
  @@index([parentId])
}

enum BrandType {
  LOGO
  OVERLAY
  BACKGROUND_IMAGE
  BACKGROUND_VIDEO
  LOWER_THIRD
  BANNER
  INTRO
  OUTRO
  FONT
  COLOR_THEME
}

model BrandAsset {
  id          String       @id @default(cuid())
  workspaceId String
  folderId    String?
  brandType   BrandType
  name        String
  storagePath String?
  settings    Json         @default("{}")
  createdAt   DateTime     @default(now())
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folder      MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([folderId])
}

enum WebinarStatus {
  DRAFT
  SCHEDULED
  LIVE
  ENDED
}

model Webinar {
  id                  String              @id @default(cuid())
  workspaceId         String
  broadcastId         String?
  title               String
  description         String?
  thumbnailUrl        String?
  scheduledAt         DateTime
  durationMinutes     Int                 @default(60)
  timezone            String              @default("UTC")
  registrationEnabled Boolean             @default(true)
  chatEnabled         Boolean             @default(true)
  viewerLimit         Int                 @default(1000)
  onDemandEnabled     Boolean             @default(false)
  status              WebinarStatus       @default(DRAFT)
  createdAt           DateTime            @default(now())
  workspace           Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  broadcast           Broadcast?          @relation(fields: [broadcastId], references: [id], onDelete: SetNull)
  registrants         WebinarRegistrant[]
  messages            WebinarMessage[]

  @@index([workspaceId])
  @@index([broadcastId])
}

model WebinarRegistrant {
  id           String   @id @default(cuid())
  webinarId    String
  firstName    String
  lastName     String
  email        String
  phone        String?
  country      String?
  customFields Json     @default("{}")
  registeredAt DateTime @default(now())
  webinar      Webinar  @relation(fields: [webinarId], references: [id], onDelete: Cascade)

  @@index([webinarId])
}

model WebinarMessage {
  id           String   @id @default(cuid())
  webinarId    String
  authorName   String
  authorEmail  String?
  message      String
  isPinned     Boolean  @default(false)
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())
  webinar      Webinar  @relation(fields: [webinarId], references: [id], onDelete: Cascade)

  @@index([webinarId])
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  RETRYING
}

model ScheduledJob {
  id          String    @id @default(cuid())
  jobType     String
  payload     Json
  scheduledAt DateTime
  status      JobStatus @default(QUEUED)
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())

  @@index([scheduledAt])
  @@index([status])
}

enum AiClipStatus {
  QUEUED
  PROCESSING
  READY
  FAILED
}

model AiClip {
  id           String       @id @default(cuid())
  recordingId  String
  title        String
  score        Float
  startTime    Float
  endTime      Float
  format       String       @default("9:16")
  storagePath  String?
  captionsPath String?
  status       AiClipStatus @default(QUEUED)
  createdAt    DateTime     @default(now())
  recording    Recording    @relation(fields: [recordingId], references: [id], onDelete: Cascade)

  @@index([recordingId])
}

enum TranscriptStatus {
  PROCESSING
  READY
  FAILED
}

model Transcript {
  id          String              @id @default(cuid())
  recordingId String
  status      TranscriptStatus    @default(PROCESSING)
  language    String              @default("en")
  createdAt   DateTime            @default(now())
  recording   Recording           @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  segments    TranscriptSegment[]

  @@index([recordingId])
}

model TranscriptSegment {
  id           String     @id @default(cuid())
  transcriptId String
  speaker      String?
  text         String
  confidence   Float
  startTime    Float
  endTime      Float
  transcript   Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@index([transcriptId])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  workspaceId String?
  action      String
  details     Json     @default("{}")
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([workspaceId])
  @@index([createdAt])
}
